# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env.
#
# Generate the two keys:
#   docker run --rm python:3.12-slim python -c \
#     "import secrets;print('DJANGO_SECRET_KEY='+secrets.token_urlsafe(64))"
#   docker run --rm python:3.12-slim sh -c \
#     "pip -q install cryptography && python -c \
#      'from cryptography.fernet import Fernet;print(\"FIELD_ENCRYPTION_KEY=\"+Fernet.generate_key().decode())'"
#
# Or on Windows PowerShell with Python installed:
#   python -c "import secrets;print(secrets.token_urlsafe(64))"
# ---------------------------------------------------------------------------

# ----------------------------------------------------------------- Django
DJANGO_SECRET_KEY=replace-me-with-64-random-chars
DJANGO_DEBUG=1

# development | staging | production.
# Outside production a Developer gets employee / enrolment / live-follow
# access directly; in production those three need a break-glass elevation.
ENVIRONMENT=development

# Which requirements file the web image installs. dev.txt adds pytest, ruff
# and the debug toolbar, which `make test` and `make lint` need.
# Set to base.txt for production images.
WEB_REQUIREMENTS=dev.txt

# Set to 1 to require an enrolled authenticator for Developer/Admin/HR.
# Defaults to on whenever DJANGO_DEBUG=0.
MFA_ENFORCED=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
TZ=Asia/Kolkata
WEB_PORT=8000
WEB_CONCURRENCY=4

# Encrypts camera RTSP URLs and credentials at rest (Fernet key, 44 chars).
# Losing this key makes every stored camera credential unrecoverable.
FIELD_ENCRYPTION_KEY=replace-me-with-a-fernet-key

# --------------------------------------------------------------- Postgres
POSTGRES_DB=cctv
POSTGRES_USER=cctv
POSTGRES_PASSWORD=replace-me-strong
# Host port for the containerised Postgres. 5433 by default so it does not
# clash with a PostgreSQL you already run locally on 5432. Connect pgAdmin or
# psql to localhost:5433 to inspect this database.
POSTGRES_PORT=5433
PG_SHARED_BUFFERS=1GB

# Read-only role used by vision workers (created by docker/db/init).
# Leave VISION_DB_USER=cctv for development; switch to vision_ro in production
# after running: docker compose exec web python manage.py grant_vision_ro
VISION_DB_USER=cctv
VISION_DB_PASSWORD=

# ------------------------------------------------------------------ Redis
REDIS_MAXMEMORY=1gb
EVENT_STREAM=events:detections
EVENT_STREAM_MAXLEN=200000

# ------------------------------------------------------ snapshot storage
# Leave S3_ENDPOINT_URL empty to store snapshots on a local Docker volume.
# Either way, snapshots are served only through the permission-checked
# streaming endpoint, never from a browsable path.
#
# For production, point these at your own bucket (AWS S3, Wasabi, Backblaze
# B2, or a self-hosted MinIO). MinIO's container images now require a
# registry login, so the bundled `minio` service sits behind the `s3`
# profile and is not started by default:
#   docker compose --profile s3 up -d minio
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=cctv-snapshots
# Browser-reachable address, used only when signing URLs for a real bucket.
S3_PUBLIC_ENDPOINT_URL=
SNAPSHOT_URL_TTL_SECONDS=180

# Only used by the optional bundled MinIO service.
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest
MINIO_ROOT_USER=cctvadmin
MINIO_ROOT_PASSWORD=replace-me-strong
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ------------------------------------------------------- first admin user
# Only used on first `docker compose up`. Remove after the account exists,
# then change the password in the UI and enrol MFA.
BOOTSTRAP_ADMIN_EMAIL=admin@yourcompany.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-immediately

# ------------------------------------------------------------- aggregator
AGGREGATOR_CONSUMER=aggregator-1
AGGREGATOR_BATCH_SIZE=200
AGGREGATOR_BLOCK_MS=1000
# A person must be absent from a zone this long before the interval closes.
PRESENCE_GAP_SECONDS=60

# ----------------------------------------------------------- vision tier
# Set MOCK_VISION=1 to exercise the whole realtime path with synthetic
# movement - no cameras, no models, no GPU required.
MOCK_VISION=0
SAMPLE_FPS=4
MIN_FACE_PX=60
VOTE_WINDOW=12
MATCH_THRESHOLD_HIGH=0.45
MATCH_THRESHOLD_LOW=0.30
GALLERY_REFRESH_SECONDS=30
SHARD_INDEX=0
SHARD_COUNT=1

# CPU default. docker-compose.gpu.yml overrides these for CUDA.
VISION_BASE_IMAGE=python:3.12-slim-bookworm
VISION_ONNX_PACKAGE=onnxruntime==1.21.0
VISION_IMAGE_TAG=cpu
EXEC_PROVIDER=CPUExecutionProvider
VISION_SHM_SIZE=1gb
GPU_COUNT=1

# ------------------------------------------------------------- retention
# Days. Enforced by the retention Celery task, not just policy.
RETENTION_DETECTION_DAYS=14
RETENTION_SNAPSHOT_DAYS=30
RETENTION_PRESENCE_DAYS=180
RETENTION_AUDIT_DAYS=730
