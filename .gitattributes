# Keep LF in the repository and in checkouts. The project's files are mounted
# into Linux containers; a CRLF entrypoint.sh fails there with
# "bad interpreter" even though it looks fine on Windows.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.mp4 binary
*.onnx binary

# Vendored libraries are verified by SHA-256 (static/vendor/MANIFEST.json):
# store them byte-for-byte, never line-ending-normalised.
static/vendor/** -text
